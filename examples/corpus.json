        "containerRefs": ["gh:folklore/architecture#12"],
        "entities": ["folklore/architecture", "PR#12"],
        "content": {
          "body": "Decision recorded: adopt Apache AGE on shared Postgres. Memgraph Fargate tasks drop from the per-tenant bill; graph semantics stay in Cypher where multi-hop is required later.",
          "explicitLinks": []
        },
        "raw": {}
      },
