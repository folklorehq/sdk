        "containerRefs": ["gh:folklore/architecture#12"],
        "entities": ["folklore/architecture", "PR#12"],
        "content": {
          "body": "Counterpoint on Memgraph: dedicated graph DB gives faster multi-hop, but we only need single-hop RELATED_TO edges today. AGE keeps RLS and backups unified with facts/containers.",
          "explicitLinks": []
        },
        "raw": {}
      },
      {
        "sourceFactId": "gh:architecture:003",
        "kind": "content",
        "occurredAt": "2026-03-11T09:00:00.000Z",
