{
  "name": "@folklore/leak-guard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "audit:browser-telemetry": "vitest run test/browser-telemetry-audit.test.ts",
    "audit:logs": "vitest run test/static-log-audit.test.ts",
    "leak:scan": "node scripts/leak-scan.mjs",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@folklore/core": "workspace:*",
    "@folklore/errors": "workspace:*",
    "@folklore/telemetry": "workspace:*",
    "@folklore/utils": "workspace:*",
    "fast-check": "^3.23.2"
  },
  "devDependencies": {
    "@folklore/contracts": "workspace:*",
    "@folklore/logger": "workspace:*",
    "@folklore/tsconfig": "workspace:*",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "zod": "^3.23.8"
  }
}
