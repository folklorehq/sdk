{
  "name": "@folklore/telemetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./events": {
      "development": "./src/events.ts",
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./content-free": {
      "development": "./src/content-free.ts",
      "types": "./dist/content-free.d.ts",
      "default": "./dist/content-free.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@folklore/tsconfig": "workspace:*",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@folklore/core": "workspace:*",
    "@folklore/errors": "workspace:*",
    "posthog-node": "^5.39.1"
  }
}
