{
  "name": "@folklore/utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "canonical-json-pure": [
        "dist/canonical-json-pure.d.ts"
      ],
      "uuid": [
        "dist/uuid.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./random": {
      "development": "./src/random.ts",
      "types": "./dist/random.d.ts",
      "default": "./dist/random.js"
    },
    "./safe-href": {
      "development": "./src/safe-href.ts",
      "types": "./dist/safe-href.d.ts",
      "default": "./dist/safe-href.js"
    },
    "./deep-freeze": {
      "development": "./src/deep-freeze.ts",
      "types": "./dist/deep-freeze.d.ts",
      "default": "./dist/deep-freeze.js"
    },
    "./text": {
      "development": "./src/text.ts",
      "types": "./dist/text.d.ts",
      "default": "./dist/text.js"
    },
    "./time": {
      "development": "./src/time.ts",
      "types": "./dist/time.d.ts",
      "default": "./dist/time.js"
    },
    "./async": {
      "development": "./src/async.ts",
      "types": "./dist/async.d.ts",
      "default": "./dist/async.js"
    },
    "./canonical-json-pure": {
      "development": "./src/canonical-json-pure.ts",
      "types": "./dist/canonical-json-pure.d.ts",
      "default": "./dist/canonical-json-pure.js"
    },
    "./json-pointer": {
      "development": "./src/json-pointer.ts",
      "types": "./dist/json-pointer.d.ts",
      "default": "./dist/json-pointer.js"
    },
    "./uuid": {
      "development": "./src/uuid.ts",
      "types": "./dist/uuid.d.ts",
      "default": "./dist/uuid.js"
    },
    "./tenant": {
      "development": "./src/tenant.ts",
      "types": "./dist/tenant.d.ts",
      "default": "./dist/tenant.js"
    },
    "./public-email-domains": {
      "development": "./src/public-email-domains.ts",
      "types": "./dist/public-email-domains.d.ts",
      "default": "./dist/public-email-domains.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@folklore/tsconfig": "workspace:*",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
