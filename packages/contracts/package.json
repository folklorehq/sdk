{
  "name": "@folklore/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enclave": {
      "development": "./src/enclave.ts",
      "types": "./dist/enclave.d.ts",
      "default": "./dist/enclave.js"
    },
    "./enclave-output": {
      "development": "./src/enclave-output.ts",
      "types": "./dist/enclave-output.d.ts",
      "default": "./dist/enclave-output.js"
    },
    "./wiki": {
      "development": "./src/wiki.ts",
      "types": "./dist/wiki.d.ts",
      "default": "./dist/wiki.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@folklore/tsconfig": "workspace:*",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
